    {
      "parameters": {
        "jsCode": "// Einfacher Anti-Flood-Schutz: verhindert, dass ein Kunde (versehentlich per Bot\n// oder absichtlich) den Claude-API-Call im Sekundentakt auslöst und dadurch Kosten\n// verursacht oder das System überlastet.\nconst existing = $input.first().json;\nconst incoming = $('Нормализация (Telegram)').first()?.json || $('Нормализация (Viber)').first()?.json;\n\nconst lastUpdated = existing.fields ? existing.fields.last_updated : null;\nconst history = existing.fields && existing.fields.conversation_history\n  ? JSON.parse(existing.fields.conversation_history)\n  : [];\n\nconst MIN_SECONDS_BETWEEN_MESSAGES = 2;\nconst MAX_MESSAGES_TOTAL = 50;\n\nlet blocked = false;\nlet reason = null;\n\nif (lastUpdated) {\n  const secondsSince = (Date.now() - new Date(lastUpdated).getTime()) / 1000;\n  if (secondsSince < MIN_SECONDS_BETWEEN_MESSAGES) {\n    blocked = true;\n    reason = 'too_fast';\n  }\n}\n\nif (history.length > MAX_MESSAGES_TOTAL) {\n  blocked = true;\n  reason = 'too_many_messages';\n}\n\nreturn [{\n  json: {\n    ...incoming,\n    record_id: existing.id || null,\n    blocked,\n    reason,\n    next_question: blocked ? 'Пожалуйста, не отправляйте сообщения так часто — я отвечу через пару секунд 🙂' : null\n  }\n}];"
      },
      "id": "code-rate-limit",
      "name": "Rate Limit: проверка частоты сообщений",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-600, 130],
      "notes": "Blockiert Nachrichten, die zu schnell hintereinander kommen (Flood-Schutz) oder wenn eine Konversation unrealistisch lang wird."
