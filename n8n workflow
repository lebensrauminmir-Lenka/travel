    {
      "parameters": {
        "jsCode": "// Harte Validierung: Werte, die technisch unmöglich/unsinnig sind\nconst input = $json;\nconst data = input.structured_data || {};\nlet status = input.status;\nlet nextQuestion = input.next_question;\nconst errors = [];\n\nif (data.budget !== undefined && data.budget !== null && (isNaN(data.budget) || Number(data.budget) <= 0)) {\n  errors.push('budget');\n}\nif (data.nights !== undefined && data.nights !== null && (Number(data.nights) < 1 || Number(data.nights) > 60)) {\n  errors.push('nights');\n}\nif (data.adults !== undefined && data.adults !== null && Number(data.adults) < 1) {\n  errors.push('adults');\n}\nif (data.dates && data.dates.month !== undefined && data.dates.month !== null) {\n  const m = Number(data.dates.month);\n  if (m < 1 || m > 12) errors.push('dates.month');\n}\n\nif (errors.length > 0) {\n  status = 'clarifying';\n  nextQuestion = `Кажется, в поле(ях) ${errors.join(', ')} есть ошибка — не могли бы вы уточнить?`;\n}\n\nreturn [{\n  json: {\n    ...input,\n    status,\n    next_question: nextQuestion,\n    validation_errors: errors\n  }\n}];"
      },
