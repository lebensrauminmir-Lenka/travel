    {
      "parameters": {
        "jsCode": "// Viber signiert jede Nachricht mit HMAC-SHA256 über den Rohtext des Bodys.\n// Ohne diese Prüfung könnte theoretisch jeder gefälschte Anfragen an diesen Webhook schicken.\nconst crypto = require('crypto');\n\nconst item = $input.first().json;\nconst headers = item.headers || {};\nconst signature = headers['x-viber-content-signature'];\nconst rawBody = item.rawBody || JSON.stringify(item.body);\nconst secret = $env.VIBER_AUTH_TOKEN;\n\nif (!secret) {\n  throw new Error('VIBER_AUTH_TOKEN ist nicht als n8n-Umgebungsvariable gesetzt.');\n}\n\nconst expected = crypto.createHmac('sha256', secret).update(rawBody).digest('hex');\n\nif (!signature || signature !== expected) {\n  throw new Error('Viber-Signatur ungültig — Anfrage wird verworfen (möglicher Spoofing-Versuch).');\n}\n\nreturn $input.all();"
      },
      "id": "viber-verify-signature",
      "name": "Viber: проверка подписи",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1080, 260],
      "notes": "Sicherheitsprüfung: verifiziert, dass die Nachricht wirklich von Viber kommt (nicht gespooft). Bricht die Ausführung ab, wenn die Signatur nicht stimmt."
    },
