    {
      "parameters": {
        "jsCode": "const raw = $json.content[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\n\nconst ctx = $('Подготовка контекста для Claude').first().json;\n\nreturn [{\n  json: {\n    chat_id: ctx.chat_id,\n    channel: ctx.channel,\n    record_id: ctx.record_id,\n    status: parsed.status,\n    structured_data: parsed.structured_data,\n    missing_fields: parsed.missing_fields || [],\n    next_question: parsed.next_question,\n    manager_summary: parsed.manager_summary,\n    conversation_history: ctx.conversation_history.concat([{ role: 'assistant', content: raw }])\n  }\n}];"
      },
      "id": "code-parse-claude",
      "name": "Разбор ответа Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 130]
